# docker-compose.yml — Umgebungsvariablen (siehe docs/TECH_STACK.md)
# Kopiere nach .env und passe die Werte an.

# Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://service.kompcards.ccdevlab.ch

# Externer LLM (separate Maschine, aus Scope) — nur die Anbindung
LLM_BASE_URL=http://llm:8000/v1
LLM_API_KEY=change-me
LLM_MODEL=your-model

# Server
NODE_ENV=development
