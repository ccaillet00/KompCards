# Backend-Umgebungsvariablen (siehe docs/TECH_STACK.md)
# Kopiere nach `.env` und passe die Werte an.

# MySQL (intern, nur Backend -> DB)
DATABASE_URL=mysql://kompcards:kompcards@db:3306/kompcards_db

# Better Auth (DB-Session, 12 Stunden, HttpOnly-Cookie)
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://service.kompcards.ccdevlab.ch

# Nur für den einmaligen Benutzerimport; explizite bestehende UUIDs, kommasepariert.
# AUTH_MIGRATION_ADMIN_USER_IDS=uuid-1,uuid-2

# Externer LLM (separate Maschine, aus Scope) — nur die Anbindung
LLM_BASE_URL=http://llm:8000/v1
LLM_API_KEY=change-me
LLM_MODEL=your-model

# Server
PORT=4000
NODE_ENV=development
